# Local env vars for HF cache paths (created by scripts/setup_venv.ps1)
env_local.ps1

# Virtual environment (never commit; recreate with py -m venv .venv)
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Local RAG / downloads (large)
chroma_db/

# Web UI chat persistence (SQLite WAL + journal live next to this file)
.rag_chat.sqlite
.rag_chat.sqlite-shm
.rag_chat.sqlite-wal

# Hugging Face / PyTorch cache when HF_HOME points at project (see scripts/setup_venv.ps1)
.cache/

# Docker local overrides
docker-compose.override.yml

# IDE
.idea/
.vscode/
*.iml

# OS
Thumbs.db
.DS_Store
